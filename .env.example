# Database (local dev matches docker-compose.yml)
DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5432/ecommerce?schema=public"

# Redis (cart cache, rate limiting, session throttling)
REDIS_URL="redis://localhost:6379"

# Auth.js
AUTH_SECRET="" # generate with: npx auth secret
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe (checkout - only payment gateway besides COD)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AWS (S3 product images + SES email, production only)
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
CLOUDFRONT_DOMAIN=""

# Transactional email
RESEND_API_KEY=""
EMAIL_FROM="orders@example.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="VND"
