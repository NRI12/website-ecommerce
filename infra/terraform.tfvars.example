# Copy to terraform.tfvars (gitignored) and fill in real values.
# Never commit terraform.tfvars.

aws_region   = "ap-southeast-1"
project_name = "website-ecommerce"
environment  = "prod"

# Set after the first `terraform apply` once you have the CloudFront domain,
# or your own custom domain if you've attached one.
app_url = "https://your-cloudfront-domain.cloudfront.net"

app_secrets = {
  auth_secret            = "generate-with-npx-auth-secret"
  auth_google_id         = ""
  auth_google_secret     = ""
  stripe_secret_key      = ""
  stripe_webhook_secret  = ""
  vnpay_tmn_code         = ""
  vnpay_secret_key       = ""
  momo_partner_code      = ""
  momo_access_key        = ""
  momo_secret_key        = ""
  resend_api_key         = ""
}
